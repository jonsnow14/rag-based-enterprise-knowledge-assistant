# Northwind RAG — Azure productized (agent-free)
# Copy: cp .env.example .env

# --- Application ---
APP_NAME=northwind-rag-azure
APP_ENV=local
APP_MODE=azure
LOG_LEVEL=INFO
# Comma-separated departments when Entra is mocked
DEV_DEFAULT_DEPARTMENTS=HR,Finance,IT,Legal,Sales

# Corpus (default: ./rag-documents under this repo; override as needed)
RAG_DOCUMENTS_PATH=./rag-documents

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=northwind-chunks

# --- Optional: Content Safety (P4+) ---
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# --- Adaptive chunking ---
CHUNK_ALPHA=3.0
CHUNK_C_MIN=128
CHUNK_C_MAX=512
CHUNK_C_MAX_ATOMIC=800
CHUNK_OVERLAP_BETA=0.12

# --- Retrieval / evidence gate ---
RAG_TOP_K=5
RAG_RETRIEVE_K=15
RAG_CONTEXT_K=5
RAG_MIN_SCORE=0.30
RAG_MIN_SCORE_AZURE=0.015
RAG_DEFAULT_IS_CURRENT=true
RERANK_MODE=lexical

# --- Control system (STRATEGY-AGAINST-COMMON-FAIL-POINTS) ---
# smart when confident / classic when not / measurable always / killable instantly
RAG_ENHANCED_PIPELINE=true
FORCE_SINGLE_PATH=false
ENABLE_QUERY_REWRITE=true
ENABLE_MULTI_QUERY=true
ENABLE_TEMPORAL_INTENT=true
ENABLE_VERSION_OFFER=false
ENABLE_VERSION_COLLAPSE=true
ALLOW_PARTIAL_ANSWERS=true
AMBIGUITY_CLARIFY_ENABLED=true
MULTI_QUERY_FALLBACK_TO_SINGLE=true
REWRITE_MIN_CONFIDENCE=0.70
MULTI_FACET_MIN_CONFIDENCE=0.75
TEMPORAL_MIN_CONFIDENCE=0.80
MAX_SUB_QUERIES=2
INCLUDE_DIAGNOSTICS_DEFAULT=false

# --- Azure AI Foundry / Evaluation (optional; see az-ai-foundary-implementation.md) ---
# Judge model can reuse chat deployment or a cheaper dedicated one:
# AZURE_OPENAI_EVAL_DEPLOYMENT=gpt-4.1-mini
# Portal logging (optional):
# AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=  # alias

# --- Local fallback (APP_MODE=local) ---
LOCAL_INDEX_PATH=data/local_index.jsonl

# --- API sharing (App Service / ACA defense-in-depth; APIM may also enforce keys) ---
# Comma-separated keys. Empty + REQUIRE_API_KEY=false → open (local dev only).
API_KEYS=
REQUIRE_API_KEY=false
# Example production:
# API_KEYS=dev-partner-key-change-me,second-key
# REQUIRE_API_KEY=true

